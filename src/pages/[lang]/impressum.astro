---
import Layout from "../../layouts/Layout.astro";
import { translations } from "../../config/i18n.config";
import { isValidLang } from "../../lib/lang";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }];
}

const { lang } = Astro.params;
if (!isValidLang(lang)) {
  return Astro.redirect("/de/");
}

const t = translations[lang];
---

<Layout lang={lang} title={t.nav.impressum}>
  <section class="section">
    <div class="container-custom" style="max-width: 850px;">
      <h1>{t.impressum.title}</h1>
      <div class="card">
        <h3>{lang === "de" ? "Angaben gemäß § 5 TMG" : "Legal Notice"}</h3>
        <p><strong>Name:</strong> [Bitte ergänzen]</p>
        <p><strong>Adresse:</strong> [Bitte ergänzen]</p>
        <p><strong>E-Mail:</strong> info@bsm-app.de</p>
        <p><strong>Telefon:</strong> [Optional]</p>
      </div>

      <div class="card" style="margin-top:1rem;">
        <h3>{lang === "de" ? "Haftungsausschluss" : "Disclaimer"}</h3>
        <p>{lang === "de" ? "Diese Seite ist ein Platzhalter. Rechtstexte müssen vor Livegang final geprüft werden." : "This section is a placeholder. Legal texts must be finalized before launch."}</p>
      </div>

      <div class="card" style="margin-top:1rem;">
        <h3>{lang === "de" ? "Datenschutz (Kurzfassung)" : "Privacy (Short Version)"}</h3>
        <p>{lang === "de" ? "Bei Nutzung des Voting-Moduls können technische Daten verarbeitet werden. Datenschutzerklärung wird nach Supabase-Livegang ergänzt." : "When using voting, technical data may be processed. Privacy policy will be finalized after Supabase go-live."}</p>
      </div>
    </div>
  </section>
</Layout>
