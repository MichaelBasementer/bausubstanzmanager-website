---
import Layout from "../../layouts/Layout.astro";
import { translations } from "../../config/i18n.config";
import { team } from "../../config/team.config";

const lang = "de" as const;
const t = translations[lang];
---

<Layout lang={lang} title={t.nav.team}>
  <section class="section">
    <div class="container-custom">
      <h1>{t.team.title}</h1>
      <p>{t.team.intro}</p>
      <div class="grid-auto" style="margin-top: 2rem;">
        {team.map((member) => (
          <article class="card">
            <img src={member.photo} alt={member.name} style="width: 120px; height: 120px; object-fit: cover; border-radius: 999px;" />
            <h3 style="margin-top: 0.8rem;">{member.name}</h3>
            <p><strong>{member.title}</strong></p>
            <p>{member.bio}</p>
          </article>
        ))}
      </div>
      <p style="margin-top:2rem; color:#666;">Diese Inhalte sind absichtlich einfach änderbar über src/config/team.config.ts</p>
    </div>
  </section>
</Layout>
