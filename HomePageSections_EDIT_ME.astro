  .sdot:nth-child(2) { animation-delay: 0.25s; }
  .sdot:nth-child(3) { animation-delay: 0.5s; }
  @keyframes dotFlow { 0%,100% { opacity:0.3; transform: scale(0.8); } 50% { opacity:1; transform: scale(1.1); } }
  .sync-badge { display: flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; font-weight: 700; color: rgba(100,180,255,0.65); border: 1px solid rgba(100,180,255,0.2); border-radius: 999px; padding: 0.35rem 0.85rem; margin-top: 0.5rem; }

  /* ── Module grid ── */
  .modules-section { background: #fff; padding: 7rem 0; }
  .modules-header { text-align: center; margin-bottom: 4rem; }
  .modules-header .section-lead { margin: 0.75rem auto 0; }
  .modules-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 900px) { .modules-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .modules-grid { grid-template-columns: 1fr; } }
  .module-card { display: flex; flex-direction: column; gap: 0.6rem; background: #fff; border-radius: 16px; padding: 1.75rem; border: 1px solid rgba(81,43,212,0.1); text-decoration: none; color: inherit; transition: all 0.25s ease; box-shadow: 0 2px 12px rgba(81,43,212,0.06); }
  .module-card:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(81,43,212,0.14); border-color: rgba(81,43,212,0.25); }
  .module-icon { font-size: 1.8rem; line-height: 1; }
  .module-platform { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: 999px; display: inline-block; width: fit-content; }
