  .module-card h3 { font-size: 1rem; font-weight: 800; color: #1e1742; margin: 0; }
  .module-card p { font-size: 0.875rem; color: #6c6791; line-height: 1.65; margin: 0; flex: 1; }
  .module-more { font-size: 0.78rem; font-weight: 700; color: #512bd4; letter-spacing: 0.04em; margin-top: auto; }

  /* ── Trust section ── */
  .trust-section { background: #0d1b2a; padding: 7rem 0; text-align: center; }
  .trust-visual { display: flex; align-items: center; justify-content: center; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .trust-node { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .trust-node span { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(196,181,244,0.55); }
  .trust-cloud span { color: rgba(124,92,232,0.8); }
  .trust-line { display: flex; gap: 0.4rem; align-items: center; }
  .tl-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(124,92,232,0.45); animation: dotFlow 1.6s ease-in-out infinite; }
  .tl-dot:nth-child(2) { animation-delay: 0.3s; }
  .tl-dot:nth-child(3) { animation-delay: 0.6s; }
  .trust-copy { max-width: 640px; margin: 0 auto 3rem; }
  .trust-copy h2 { font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 900; color: #fff; line-height: 1.2; margin: 0 0 1rem; letter-spacing: -0.02em; }
  .trust-copy p { font-size: 0.95rem; color: rgba(196,181,244,0.65); line-height: 1.75; margin: 0; }
  .trust-badges { display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center; }
  .trust-badge { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid rgba(124,92,232,0.3); color: rgba(196,181,244,0.7); }
</style>

<!-- ══════════════════════════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════════════════════════════ -->
<script>
  // ── Interactive Floor Plan ────────────────────────────────
  const svg = document.getElementById('floorplanSvg') as SVGSVGElement | null;
  const markerLayer = document.getElementById('markerLayer');
  const probeList = document.getElementById('probeList') as HTMLUListElement | null;
  const probeEmpty = document.getElementById('probeEmpty');
  const probeCount = document.getElementById('probeCount');
  const btnSync = document.getElementById('btnSync') as HTMLButtonElement | null;
  const btnReset = document.getElementById('btnReset') as HTMLButtonElement | null;
  const syncDone = document.getElementById('syncDone');
  const syncTable = document.getElementById('syncTable');
  const hintPulse = document.getElementById('hintPulse');
  const floorplanHint = document.getElementById('floorplanHint');

  let activeType: 'probe' | 'sond' | 'room' = 'probe';
  const counters = { probe: 0, sond: 0, room: 0 };
  type MarkerEntry = { id: string; type: 'probe' | 'sond' | 'room'; room: string };
  const placed: MarkerEntry[] = [];

  const typeConfig = {
    probe: { prefix: 'MP', color: '#e5402a', dotColor: '#e5402a' },
    sond:  { prefix: 'SK', color: '#f59e0b', dotColor: '#f59e0b' },
    room:  { prefix: 'R',  color: '#1da9f2', dotColor: '#1da9f2' },
  };

  // Toolbar buttons
  document.querySelectorAll<HTMLButtonElement>('.marker-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.marker-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeType = btn.dataset.type as 'probe' | 'sond' | 'room';
    });
  });

  function getId(type: 'probe' | 'sond' | 'room') {
    counters[type]++;
    const n = String(counters[type]).padStart(2, '0');
    return `${typeConfig[type].prefix}-${n}`;
  }

  function placeMarker(cx: number, cy: number, type: 'probe' | 'sond' | 'room', id: string) {
    if (!markerLayer) return;
    const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    g.setAttribute('class', 'placed-marker');
    g.setAttribute('opacity', '0');

    if (type === 'probe') {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', String(cx)); c.setAttribute('cy', String(cy)); c.setAttribute('r', '11');
      c.setAttribute('fill', 'rgba(229,64,42,0.12)'); c.setAttribute('stroke', '#e5402a'); c.setAttribute('stroke-width', '2');
      const l1 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      l1.setAttribute('x1',String(cx-6)); l1.setAttribute('y1',String(cy-6)); l1.setAttribute('x2',String(cx+6)); l1.setAttribute('y2',String(cy+6));
      l1.setAttribute('stroke','#e5402a'); l1.setAttribute('stroke-width','2'); l1.setAttribute('stroke-linecap','round');
      const l2 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      l2.setAttribute('x1',String(cx+6)); l2.setAttribute('y1',String(cy-6)); l2.setAttribute('x2',String(cx-6)); l2.setAttribute('y2',String(cy+6));
      l2.setAttribute('stroke','#e5402a'); l2.setAttribute('stroke-width','2'); l2.setAttribute('stroke-linecap','round');
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x',String(cx+14)); t.setAttribute('y',String(cy+4)); t.setAttribute('font-family',"'JetBrains Mono',monospace");
      t.setAttribute('font-size','9'); t.setAttribute('fill','#e5402a'); t.setAttribute('font-weight','700'); t.textContent = id;
      g.append(c, l1, l2, t);
    } else if (type === 'sond') {
      const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      poly.setAttribute('points', `${cx},${cy-12} ${cx+11},${cy+7} ${cx-11},${cy+7}`);
      poly.setAttribute('fill', 'rgba(245,158,11,0.14)'); poly.setAttribute('stroke', '#f59e0b'); poly.setAttribute('stroke-width', '2'); poly.setAttribute('stroke-linejoin', 'round');
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x',String(cx+14)); t.setAttribute('y',String(cy+4)); t.setAttribute('font-family',"'JetBrains Mono',monospace");
      t.setAttribute('font-size','9'); t.setAttribute('fill','#f59e0b'); t.setAttribute('font-weight','700'); t.textContent = id;
      g.append(poly, t);
    } else {
      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      rect.setAttribute('x',String(cx-8)); rect.setAttribute('y',String(cy-8)); rect.setAttribute('width','16'); rect.setAttribute('height','16');
      rect.setAttribute('rx','3'); rect.setAttribute('fill','#1da9f2');
      const letter = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      letter.setAttribute('x',String(cx)); letter.setAttribute('y',String(cy+5)); letter.setAttribute('font-family',"'JetBrains Mono',monospace");
      letter.setAttribute('font-size','10'); letter.setAttribute('fill','#fff'); letter.setAttribute('text-anchor','middle'); letter.setAttribute('font-weight','800'); letter.textContent = 'R';
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x',String(cx+12)); t.setAttribute('y',String(cy+5)); t.setAttribute('font-family',"'JetBrains Mono',monospace");
      t.setAttribute('font-size','9'); t.setAttribute('fill','#1da9f2'); t.setAttribute('font-weight','700'); t.textContent = id;
      g.append(rect, letter, t);
    }

    markerLayer!.appendChild(g);
    requestAnimationFrame(() => { g.setAttribute('opacity', '1'); g.style.transition = 'opacity 0.25s ease'; });
  }

  function addToList(entry: MarkerEntry) {
    if (!probeList || !probeEmpty || !probeCount) return;
    probeEmpty.style.display = 'none';
    const li = document.createElement('li');
    li.className = 'probe-item';
    const cfg = typeConfig[entry.type];
    li.innerHTML = `<span class="probe-item-dot" style="background:${cfg.dotColor}"></span><span class="probe-item-id">${entry.id}</span><span class="probe-item-room">${entry.room}</span>`;
    probeList.appendChild(li);
    probeList.scrollTop = probeList.scrollHeight;
    probeCount.textContent = String(placed.length);

    if (placed.length >= 2 && btnSync) {
      btnSync.classList.remove('hidden');
      btnSync.setAttribute('aria-hidden', 'false');
    }
  }

  // Room click handler
  document.querySelectorAll<SVGRectElement>('.room-zone').forEach(zone => {
    zone.addEventListener('click', (e) => {
      e.stopPropagation();
      if (syncDone && !syncDone.classList.contains('hidden')) return;

      const pt = svg!.createSVGPoint();
      pt.x = (e as MouseEvent).clientX;
      pt.y = (e as MouseEvent).clientY;
      const svgP = pt.matrixTransform(svg!.getScreenCTM()!.inverse());

      // Jitter so multiple markers in same room don't stack
      const jx = (Math.random() - 0.5) * 30;
      const jy = (Math.random() - 0.5) * 20;
      const baseCx = parseFloat(zone.dataset.cx || '200');
      const baseCy = parseFloat(zone.dataset.cy || '200');
      const cx = Math.round(baseCx + jx);
      const cy = Math.round(baseCy + jy);

      const id = getId(activeType);
      const roomName = zone.dataset.room || '?';
      const entry: MarkerEntry = { id, type: activeType, room: roomName };
      placed.push(entry);

      placeMarker(cx, cy, activeType, id);
      addToList(entry);

      // Hide hint after first click
      if (hintPulse) hintPulse.style.display = 'none';
      if (floorplanHint) floorplanHint.style.display = 'none';
    });
  });

  // Sync button
  btnSync?.addEventListener('click', () => {
    if (!syncDone || !syncTable || !btnSync || !btnReset) return;
    btnSync.classList.add('hidden');
    syncDone.classList.remove('hidden');
    btnReset.classList.remove('hidden');
    syncTable.innerHTML = '';
    placed.forEach(entry => {
      const li = document.createElement('li');
      li.className = 'sync-row';
      const cfg = typeConfig[entry.type];
      li.innerHTML = `<span style="color:${cfg.dotColor};font-weight:700">${entry.id}</span><span style="color:rgba(200,220,255,0.6)">${entry.room}</span>`;
      syncTable.appendChild(li);
    });
  });

  // Reset
  btnReset?.addEventListener('click', () => {
    placed.length = 0;
    counters.probe = 0; counters.sond = 0; counters.room = 0;
    if (markerLayer) markerLayer.innerHTML = '';
    if (probeList) { probeList.innerHTML = ''; probeList.appendChild(probeEmpty!); }
    if (probeEmpty) probeEmpty.style.display = '';
    if (probeCount) probeCount.textContent = '0';
    if (btnSync) { btnSync.classList.add('hidden'); btnSync.setAttribute('aria-hidden','true'); }
    if (syncDone) syncDone.classList.add('hidden');
    if (btnReset) btnReset.classList.add('hidden');
    if (hintPulse) hintPulse.style.display = '';
    if (floorplanHint) floorplanHint.style.display = '';
  });

  // ── Scrollytelling ─────────────────────────────────────
  const steps = document.querySelectorAll<HTMLElement>('.workflow-step');
  const panels = document.querySelectorAll<HTMLElement>('.workflow-panel');

  function showPanel(idx: number) {
    panels.forEach((p, i) => {
      if (i === idx) { p.classList.remove('hidden'); }
      else { p.classList.add('hidden'); }
    });
    steps.forEach((s, i) => s.classList.toggle('is-active', i === idx));
  }

  const stepObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const idx = parseInt((entry.target as HTMLElement).dataset.step || '0', 10);
          showPanel(idx);
        }
      });
    },
    { threshold: 0.5, rootMargin: '-10% 0px -40% 0px' }
  );

  steps.forEach(step => stepObserver.observe(step));
  showPanel(0);

  // ── Scroll reveal for module cards ─────────────────────
  const revealObs = new IntersectionObserver(
    (entries) => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.scroll-reveal').forEach(el => revealObs.observe(el));
</script>
