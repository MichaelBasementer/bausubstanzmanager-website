---
import { getFeaturesForLang } from "../config/features.config";
import type { SiteLang } from "../lib/lang";
import { translations } from "../config/i18n.config";

interface Props {
  lang: SiteLang;
  isDE: boolean;
}

const { lang, isDE } = Astro.props as Props;
const t = translations[lang];
const features = getFeaturesForLang(lang);

const workflowSteps = isDE
  ? [
      {
        num: "01",
        tag: "Desktop · 5 Minuten",
        title: "Projekt anlegen",
        body: "Grundriss hochladen, Projekt benennen, Team einrichten. BSM ist in Minuten einsatzbereit.",
        points: ["Eigene Grundrisse als Planvorlage", "Mehrere Gebäude & Etagen", "Team-Zuordnung und Rollen"],
      },
      {
        num: "02",
        tag: "Tablet · Offline-First",
        title: "Im Feld erfassen",
        body: "Auf der Baustelle arbeitest du offline — Proben, Sondierungen, Räume, Fotos. Alles landet direkt auf dem Grundriss.",
        points: ["Probenerfassung & Sondierungen", "Raumerfassung & Mengen", "Fotodokumentation mit GPS"],
      },
      {
        num: "03",
        tag: "1 Klick",
        title: "Synchronisieren",
        body: "Zurück im Büro: ein Klick, alles ist da. Verschlüsselt übertragen, DSGVO-konform, kein manuelles Übertragen.",
        points: ["AES-256 verschlüsselt", "Azure Deutschland (Frankfurt)", "Konfliktfreie Synchronisation"],
      },
      {
        num: "04",
        tag: "Desktop · Büro",
        title: "Fertigstellen & Berichten",
        body: "Mengenermittlung, Labor-Workflow, Planerstellung und Berichterstellung — alles in einem Werkzeug.",
        points: ["Mengenermittlung & Pläne", "Labor-Workflow & Ergebnisse", "PDF & Excel Export"],
      },
    ]
  : [
      {
        num: "01",
        tag: "Desktop · 5 minutes",
        title: "Create Project",
        body: "Upload floor plans, name the project, set up the team. BSM is ready in minutes.",
        points: ["Your own floor plans as templates", "Multiple buildings & floors", "Team assignment and roles"],
      },
      {
        num: "02",
        tag: "Tablet · Offline-First",
        title: "Capture in the Field",
        body: "On site you work fully offline — samples, drillings, rooms, photos. Everything lands directly on the floor plan.",
        points: ["Sample & drilling capture", "Room capture & quantities", "Photo documentation with GPS"],
      },
      {
        num: "03",
        tag: "1 Click",
        title: "Synchronize",
        body: "Back at the office: one click and everything is there. Encrypted transfer, GDPR-compliant, no manual copying.",
        points: ["AES-256 encrypted", "Azure Germany (Frankfurt)", "Conflict-free synchronization"],
      },
      {
        num: "04",
        tag: "Desktop · Office",
        title: "Finish & Report",
        body: "Quantity estimation, lab workflow, plan creation and report generation — all in one tool.",
        points: ["Quantity estimation & plans", "Lab workflow & results", "PDF & Excel export"],
      },
    ];

const trustBadges = ["VDI 6202", "AES-256", "SQLCipher", "Azure Frankfurt", "Offline-First", "DSGVO-konform"];
---

<!-- ══════════════════════════════════════════════════════════
     HERO + INTERACTIVE DEMO
═══════════════════════════════════════════════════════════════ -->
<section class="hero-demo" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg class="hero-grid-svg" viewBox="0 0 1600 900" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <rect width="1600" height="900" fill="#0d1b2a"/>
      <defs>
        <pattern id="hgrid-fine" width="24" height="24" patternUnits="userSpaceOnUse">
          <path d="M 24 0 L 0 0 0 24" fill="none" stroke="rgba(100,180,255,0.055)" stroke-width="0.5"/>
        </pattern>
        <pattern id="hgrid-major" width="120" height="120" patternUnits="userSpaceOnUse">
          <rect width="120" height="120" fill="url(#hgrid-fine)"/>
          <path d="M 120 0 L 0 0 0 120" fill="none" stroke="rgba(100,180,255,0.10)" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="1600" height="900" fill="url(#hgrid-major)"/>
    </svg>
  </div>

  <div class="hero-layout">
    <!-- Left: Interactive Floor Plan -->
    <div class="floorplan-wrapper">
      <div class="floorplan-label" aria-hidden="true">{isDE ? "GRUNDRISS EG · INTERAKTIV" : "FLOOR PLAN GF · INTERACTIVE"}</div>
      <div class="floorplan-container" id="floorplanContainer">
        <svg
          id="floorplanSvg"
          class="floorplan-svg"
          viewBox="0 0 680 520"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label={isDE ? "Interaktiver Grundriss" : "Interactive floor plan"}
        >
          <!-- Outer wall -->
          <rect x="20" y="20" width="640" height="480" fill="none" stroke="rgba(100,180,255,0.7)" stroke-width="5"/>
          <rect x="24" y="24" width="632" height="472" fill="none" stroke="rgba(100,180,255,0.15)" stroke-width="1.5"/>

          <!-- Interior walls -->
          <line x1="260" y1="20" x2="260" y2="300" stroke="rgba(100,180,255,0.6)" stroke-width="4"/>
          <line x1="20" y1="300" x2="450" y2="300" stroke="rgba(100,180,255,0.6)" stroke-width="4"/>
          <line x1="450" y1="20" x2="450" y2="300" stroke="rgba(100,180,255,0.6)" stroke-width="4"/>
          <line x1="260" y1="160" x2="450" y2="160" stroke="rgba(100,180,255,0.5)" stroke-width="3"/>
          <line x1="450" y1="180" x2="660" y2="180" stroke="rgba(100,180,255,0.5)" stroke-width="3"/>

          <!-- Door arcs -->
          <line x1="260" y1="110" x2="260" y2="150" stroke="#0d1b2a" stroke-width="6"/>
          <path d="M 260 110 A 40 40 0 0 0 300 110" fill="none" stroke="rgba(100,180,255,0.35)" stroke-width="1.5" stroke-dasharray="4,3"/>
          <line x1="180" y1="300" x2="220" y2="300" stroke="#0d1b2a" stroke-width="6"/>
          <path d="M 180 300 A 40 40 0 0 1 180 260" fill="none" stroke="rgba(100,180,255,0.35)" stroke-width="1.5" stroke-dasharray="4,3"/>

          <!-- Room labels -->
          <text x="135" y="175" font-family="'JetBrains Mono',monospace" font-size="11" fill="rgba(100,180,255,0.5)" text-anchor="middle" letter-spacing="0.08em">EINGANG</text>
          <text x="350" y="90" font-family="'JetBrains Mono',monospace" font-size="11" fill="rgba(100,180,255,0.5)" text-anchor="middle" letter-spacing="0.08em">BÜRO 1</text>
          <text x="350" y="240" font-family="'JetBrains Mono',monospace" font-size="11" fill="rgba(100,180,255,0.5)" text-anchor="middle" letter-spacing="0.08em">BÜRO 2</text>
          <text x="560" y="100" font-family="'JetBrains Mono',monospace" font-size="11" fill="rgba(100,180,255,0.5)" text-anchor="middle" letter-spacing="0.08em">TECHNIK</text>
          <text x="560" y="340" font-family="'JetBrains Mono',monospace" font-size="11" fill="rgba(100,180,255,0.5)" text-anchor="middle" letter-spacing="0.08em">LAGER</text>
          <text x="230" y="420" font-family="'JetBrains Mono',monospace" font-size="11" fill="rgba(100,180,255,0.5)" text-anchor="middle" letter-spacing="0.08em">FLUR</text>

          <!-- Clickable room zones (transparent overlays) -->
          <rect id="room-eingang" class="room-zone" x="22" y="22" width="236" height="276" fill="transparent" data-room={isDE ? "Eingang" : "Entrance"} data-cx="135" data-cy="160"/>
          <rect id="room-buero1" class="room-zone" x="262" y="22" width="186" height="136" fill="transparent" data-room={isDE ? "Büro 1" : "Office 1"} data-cx="350" data-cy="80"/>
          <rect id="room-buero2" class="room-zone" x="262" y="162" width="186" height="136" fill="transparent" data-room={isDE ? "Büro 2" : "Office 2"} data-cx="350" data-cy="230"/>
          <rect id="room-technik" class="room-zone" x="452" y="22" width="206" height="156" fill="transparent" data-room={isDE ? "Technik" : "Utility"} data-cx="555" data-cy="90"/>
          <rect id="room-lager" class="room-zone" x="452" y="182" width="206" height="316" fill="transparent" data-room={isDE ? "Lager" : "Storage"} data-cx="555" data-cy="340"/>
          <rect id="room-flur" class="room-zone" x="22" y="302" width="428" height="196" fill="transparent" data-room={isDE ? "Flur" : "Corridor"} data-cx="230" data-cy="400"/>

          <!-- Marker layer (JS injects here) -->
          <g id="markerLayer"></g>

          <!-- Hint pulse ring (shown initially) -->
          <circle id="hintPulse" cx="350" cy="230" r="22" fill="none" stroke="rgba(124,92,232,0.6)" stroke-width="2" stroke-dasharray="6,4"/>
        </svg>

        <div class="floorplan-hint" id="floorplanHint" aria-live="polite">
          <span class="hint-icon">↑</span>
          {t.home.demoHint}
        </div>
      </div>
    </div>

    <!-- Right: Glass card -->
    <div class="hero-card">
      <div class="hero-eyebrow">
        <span class="dot-red"></span> Materialprobe
        <span class="sep">·</span>
        <span class="dot-yellow"></span> Sondierung
        <span class="sep">·</span>
        <span class="dot-blue">R</span> Raumerfassung
      </div>

      <h1 class="hero-headline">{t.home.headline}</h1>
      <p class="hero-sub">{t.home.subheadline}</p>

      <!-- Marker toolbar -->
      <div class="marker-toolbar" role="group" aria-label={isDE ? "Markertyp auswählen" : "Select marker type"}>
        <button class="marker-btn marker-probe active" id="btnProbe" data-type="probe">
          <svg width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><line x1="8" y1="8" x2="16" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="16" y1="8" x2="8" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          {isDE ? "Materialprobe" : "Sample"}
        </button>
        <button class="marker-btn marker-sond" id="btnSond" data-type="sond">
          <svg width="16" height="14" viewBox="0 0 24 20"><polygon points="12,2 22,18 2,18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          {isDE ? "Sondierung" : "Drilling"}
        </button>
        <button class="marker-btn marker-room" id="btnRoom" data-type="room">
          <span style="font-size:11px;font-weight:800;line-height:1;">R</span>
          {isDE ? "Raumerfassung" : "Room"}
        </button>
      </div>

      <!-- Live probe list -->
      <div class="probe-list-panel">
        <div class="probe-list-header">
          <span>{t.home.demoProbeList}</span>
          <span class="probe-count" id="probeCount">0</span>
        </div>
        <ul class="probe-list" id="probeList">
          <li class="probe-empty" id="probeEmpty">{t.home.demoEmpty}</li>
        </ul>
      </div>

      <!-- Sync button (hidden until markers placed) -->
      <button class="btn-sync hidden" id="btnSync" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8M3 22v-6h6M21 12a9 9 0 0 1-15 6.7L3 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {t.home.demoSync}
      </button>

      <!-- Synced state (hidden until sync fired) -->
      <div class="sync-done hidden" id="syncDone">
        <div class="sync-done-header">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {isDE ? "Desktop synchronisiert" : "Desktop synced"}
        </div>
        <ul class="sync-table" id="syncTable"></ul>
      </div>

      <!-- Reset -->
      <button class="btn-reset hidden" id="btnReset">
        {t.home.demoReset}
      </button>

      <!-- Nav CTAs -->
      <div class="hero-ctas">
        <a class="btn btn-primary" href={`/${lang}/app`}>{t.home.cta}</a>
        <a class="btn btn-secondary" href={`/${lang}/roadmap`}>{t.home.ctaSecondary}</a>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SCROLLYTELLING WORKFLOW
═══════════════════════════════════════════════════════════════ -->
<section class="workflow-section" id="workflow">
  <div class="workflow-inner">
    <!-- Left: scrolling steps -->
    <div class="workflow-steps" id="workflowSteps">
      {workflowSteps.map((step, i) => (
        <div class="workflow-step" data-step={i} id={`step-${i}`}>
          <div class="step-num">{step.num}</div>
          <span class="step-tag">{step.tag}</span>
          <h2 class="step-title">{step.title}</h2>
          <p class="step-body">{step.body}</p>
          <ul class="step-points">
            {step.points.map(p => <li>{p}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <!-- Right: sticky visual panels -->
    <div class="workflow-visuals" id="workflowVisuals">
      <!-- Panel 0: Desktop / projekt anlegen -->
      <div class="workflow-panel" id="wp-0">
        <div class="device-frame device-desktop">
          <div class="device-bar">
            <span class="dev-dot"></span><span class="dev-dot"></span><span class="dev-dot"></span>
            <span class="dev-title">BSM Desktop — {isDE ? "Neues Projekt" : "New Project"}</span>
          </div>
          <div class="device-screen">
            <svg viewBox="0 0 420 260" xmlns="http://www.w3.org/2000/svg">
              <rect width="420" height="260" fill="#f4f1fe"/>
              <rect x="10" y="10" width="130" height="240" rx="6" fill="#fff" stroke="rgba(81,43,212,0.15)" stroke-width="1"/>
              <rect x="15" y="15" width="120" height="28" rx="4" fill="#512bd4"/>
              <text x="75" y="33" font-family="Inter,sans-serif" font-size="10" fill="#fff" text-anchor="middle" font-weight="700">{isDE ? "+ Neues Projekt" : "+ New Project"}</text>
              <rect x="15" y="52" width="120" height="22" rx="3" fill="rgba(81,43,212,0.08)" stroke="rgba(81,43,212,0.2)" stroke-width="1"/>
              <text x="75" y="67" font-family="Inter,sans-serif" font-size="9" fill="#512bd4" text-anchor="middle">Musterstraße 12</text>
              <rect x="150" y="10" width="260" height="240" rx="6" fill="#fff" stroke="rgba(81,43,212,0.1)" stroke-width="1"/>
              <rect x="160" y="18" width="240" height="140" rx="4" fill="#f4f1fe"/>
              <text x="280" y="92" font-family="'JetBrains Mono',monospace" font-size="11" fill="rgba(81,43,212,0.4)" text-anchor="middle">{isDE ? "Grundriss hochladen" : "Upload floor plan"}</text>
              <rect x="240" y="170" width="120" height="22" rx="4" fill="#512bd4"/>
              <text x="300" y="185" font-family="Inter,sans-serif" font-size="9" fill="#fff" text-anchor="middle" font-weight="700">{isDE ? "Projekt starten" : "Start Project"}</text>
            </svg>
          </div>
        </div>
      </div>

      <!-- Panel 1: Tablet / im Feld -->
      <div class="workflow-panel hidden" id="wp-1">
        <div class="device-frame device-tablet">
          <span class="device-camera" aria-hidden="true"></span>
          <div class="device-screen">
            <svg viewBox="0 0 320 240" xmlns="http://www.w3.org/2000/svg">
              <rect width="320" height="240" fill="#0d1b2a"/>
              <defs>
                <pattern id="tgrid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(100,180,255,0.07)" stroke-width="0.5"/>
                </pattern>
              </defs>
              <rect width="320" height="240" fill="url(#tgrid)"/>
              <rect x="30" y="20" width="260" height="200" fill="none" stroke="rgba(100,180,255,0.6)" stroke-width="3"/>
              <line x1="140" y1="20" x2="140" y2="220" stroke="rgba(100,180,255,0.4)" stroke-width="2"/>
              <line x1="30" y1="120" x2="290" y2="120" stroke="rgba(100,180,255,0.4)" stroke-width="2"/>
              <!-- Animated markers -->
              <circle class="tmarker" cx="85" cy="70" r="9" fill="none" stroke="#e5402a" stroke-width="2"/>
              <line x1="80" y1="65" x2="90" y2="75" stroke="#e5402a" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="90" y1="65" x2="80" y2="75" stroke="#e5402a" stroke-width="1.8" stroke-linecap="round"/>
              <text x="100" y="68" font-family="'JetBrains Mono',monospace" font-size="8" fill="#e5402a" font-weight="700">MP-01</text>
              <polygon class="tmarker" points="200,55 210,75 190,75" fill="none" stroke="#f59e0b" stroke-width="2"/>
              <text x="215" y="70" font-family="'JetBrains Mono',monospace" font-size="8" fill="#f59e0b" font-weight="700">SK-01</text>
              <rect class="tmarker" x="60" y="140" width="16" height="16" rx="3" fill="#1da9f2"/>
              <text x="68" y="152" font-family="'JetBrains Mono',monospace" font-size="9" fill="#fff" text-anchor="middle" font-weight="800">R</text>
              <text x="82" y="152" font-family="'JetBrains Mono',monospace" font-size="8" fill="#1da9f2" font-weight="700">R-01</text>
            </svg>
          </div>
        </div>
      </div>

      <!-- Panel 2: Sync animation -->
      <div class="workflow-panel hidden" id="wp-2">
        <div class="sync-visual">
          <div class="sync-device sync-tablet">
            <svg width="48" height="64" viewBox="0 0 48 64"><rect x="2" y="2" width="44" height="60" rx="6" fill="none" stroke="rgba(100,180,255,0.7)" stroke-width="2"/><rect x="8" y="8" width="32" height="44" rx="2" fill="rgba(100,180,255,0.08)"/><circle cx="24" cy="57" r="2" fill="rgba(100,180,255,0.4)"/></svg>
            <span>{isDE ? "Tablet" : "Tablet"}</span>
          </div>
          <div class="sync-dots" aria-hidden="true">
            <span class="sdot"></span><span class="sdot"></span><span class="sdot"></span>
          </div>
          <div class="sync-cloud">
            <svg width="48" height="36" viewBox="0 0 48 36"><path d="M36 30H12a10 10 0 0 1-2-19.8A14 14 0 0 1 38 18a8 8 0 0 1-2 12z" fill="none" stroke="rgba(124,92,232,0.9)" stroke-width="2"/></svg>
            <span>Azure DE</span>
          </div>
          <div class="sync-dots" aria-hidden="true">
            <span class="sdot"></span><span class="sdot"></span><span class="sdot"></span>
          </div>
          <div class="sync-device sync-desktop">
            <svg width="64" height="48" viewBox="0 0 64 48"><rect x="2" y="2" width="60" height="38" rx="4" fill="none" stroke="rgba(100,180,255,0.7)" stroke-width="2"/><rect x="8" y="8" width="48" height="26" rx="2" fill="rgba(100,180,255,0.08)"/><rect x="22" y="42" width="20" height="4" rx="2" fill="rgba(100,180,255,0.3)"/></svg>
            <span>Desktop</span>
          </div>
          <div class="sync-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" stroke="rgba(100,180,255,0.8)" stroke-width="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="rgba(100,180,255,0.8)" stroke-width="2" stroke-linecap="round"/></svg>
            {isDE ? "Ende-zu-Ende verschlüsselt" : "End-to-end encrypted"}
          </div>
        </div>
      </div>

      <!-- Panel 3: Desktop / büro -->
      <div class="workflow-panel hidden" id="wp-3">
        <div class="device-frame device-desktop">
          <div class="device-bar">
            <span class="dev-dot"></span><span class="dev-dot"></span><span class="dev-dot"></span>
            <span class="dev-title">BSM Desktop — {isDE ? "Auswertung" : "Analysis"}</span>
          </div>
          <div class="device-screen">
            <svg viewBox="0 0 420 260" xmlns="http://www.w3.org/2000/svg">
              <rect width="420" height="260" fill="#f4f1fe"/>
              <rect x="10" y="10" width="130" height="240" rx="6" fill="#fff" stroke="rgba(81,43,212,0.12)" stroke-width="1"/>
              <rect x="15" y="15" width="120" height="20" rx="3" fill="rgba(81,43,212,0.08)"/>
              <text x="75" y="28" font-family="Inter,sans-serif" font-size="9" fill="#512bd4" text-anchor="middle">{isDE ? "Probenübersicht" : "Sample Overview"}</text>
              <rect x="15" y="42" width="120" height="18" rx="3" fill="rgba(81,43,212,0.04)"/>
              <text x="75" y="54" font-family="Inter,sans-serif" font-size="8" fill="#6c6791" text-anchor="middle">{isDE ? "Mengenermittlung" : "Quantities"}</text>
              <rect x="15" y="66" width="120" height="18" rx="3" fill="rgba(81,43,212,0.04)"/>
              <text x="75" y="78" font-family="Inter,sans-serif" font-size="8" fill="#6c6791" text-anchor="middle">{isDE ? "Labor-Workflow" : "Lab Workflow"}</text>
              <rect x="15" y="90" width="120" height="18" rx="3" fill="rgba(81,43,212,0.04)"/>
              <text x="75" y="102" font-family="Inter,sans-serif" font-size="8" fill="#6c6791" text-anchor="middle">{isDE ? "Berichte & Export" : "Reports & Export"}</text>
              <rect x="150" y="10" width="260" height="115" rx="6" fill="#fff" stroke="rgba(81,43,212,0.1)" stroke-width="1"/>
              <text x="280" y="26" font-family="Inter,sans-serif" font-size="9" fill="#1e1742" text-anchor="middle" font-weight="700">{isDE ? "Proben (5)" : "Samples (5)"}</text>
              <rect x="158" y="32" width="244" height="1" fill="rgba(81,43,212,0.1)"/>
              {[["MP-01","Linoleumkleber","PK3"],["MP-02","Putz","PK1"],["SK-01","Kernbohrung","—"],["R-01","Büro 1","—"]].map((row, ri) => (
                <g transform={`translate(0,${44 + ri * 22})`}>
                  <text x="162" y="10" font-family="'JetBrains Mono',monospace" font-size="8" fill="#512bd4">{row[0]}</text>
                  <text x="210" y="10" font-family="Inter,sans-serif" font-size="8" fill="#1e1742">{row[1]}</text>
                  <rect x="334" y="2" width="28" height="12" rx="3" fill={ri < 2 ? "rgba(229,64,42,0.15)" : "rgba(81,43,212,0.1)"}/>
                  <text x="348" y="11" font-family="Inter,sans-serif" font-size="7" fill={ri < 2 ? "#e5402a" : "#512bd4"} text-anchor="middle">{row[2]}</text>
                </g>
              ))}
              <rect x="150" y="134" width="125" height="116" rx="6" fill="#fff" stroke="rgba(81,43,212,0.1)" stroke-width="1"/>
