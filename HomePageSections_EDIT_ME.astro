  .workflow-step.is-active { opacity: 1; }
  .step-num { font-family: 'JetBrains Mono', monospace; font-size: 3.5rem; font-weight: 900; color: rgba(124,92,232,0.15); line-height: 1; margin-bottom: 0.5rem; }
  .step-tag { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(124,92,232,0.75); display: block; margin-bottom: 1rem; }
  .step-title { font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 900; color: #fff; line-height: 1.1; margin: 0 0 1rem; letter-spacing: -0.02em; }
  .step-body { font-size: 1rem; color: rgba(196,181,244,0.75); line-height: 1.75; margin: 0 0 1.5rem; max-width: 480px; }
  .step-points { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .step-points li { font-size: 0.9rem; color: rgba(196,181,244,0.65); padding-left: 1.4rem; position: relative; }
  .step-points li::before { content: "→"; position: absolute; left: 0; color: #7c5ce8; font-weight: 700; }

  .workflow-visuals { position: sticky; top: 64px; height: calc(100vh - 64px); display: flex; align-items: center; justify-content: center; padding: 2rem 0 2rem 3rem; }
  @media (max-width: 900px) { .workflow-visuals { display: none; } }
  .workflow-panel { width: 100%; transition: opacity 0.5s ease, transform 0.5s ease; }
  .workflow-panel.hidden { display: none; }

  /* Device frames */
  .device-frame { border-radius: 16px; overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06); }
  .device-desktop { background: linear-gradient(145deg, #1a1530, #0e0b20); }
  .device-bar { background: #1e1742; padding: 0.6rem 0.85rem; display: flex; align-items: center; gap: 0.4rem; }
